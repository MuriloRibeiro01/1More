# Copie para .env na raiz (não versionado). Valores apenas para desenvolvimento local.
# Compose: com -f infra/docker-compose.yml ele NÃO lê o .env da raiz; use
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
# Backend: o Spring não lê .env. No perfil dev (./mvnw spring-boot:run) os defaults já batem com o
# compose; para outros valores, exporte as variáveis SPRING_DATASOURCE_* no shell.
POSTGRES_DB=onemore
POSTGRES_USER=onemore
POSTGRES_PASSWORD=onemore_dev
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/onemore
SPRING_DATASOURCE_USERNAME=onemore
SPRING_DATASOURCE_PASSWORD=onemore_dev
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-bytes
